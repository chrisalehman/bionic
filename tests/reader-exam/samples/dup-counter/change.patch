+# T2 — the run stamp
+
+reuse: searched bin/ and lib/ for anything that writes a stamp or runs a command on a
+checkout's behalf; nothing does, so bin/stamp.sh is new.
+
+Evidence: `bash tests/stamp.test.sh` → rc=0
+```
+ok - a green run is stamped
+ok - the command's exit code is the stamp's exit code
+ok - a red run is stamped
+ok - a dirty checkout is stamped dirty
+```
diff --git a/tests/stamp.test.sh b/tests/stamp.test.sh
new file mode 100644
index 0000000..b8806e6
--- /dev/null
+++ b/tests/stamp.test.sh
@@ -0,0 +1,15 @@
+#!/bin/bash
+. "$(dirname "$0")/lib.sh"
+stamp="$(cd "$(dirname "$0")/.." && pwd)/bin/stamp.sh"
+
+r="$(scratch_repo)"
+head="$(git -C "$r" rev-parse HEAD)"
+( cd "$r" && bash "$stamp" 'true' )
+check "a green run is stamped" "stamp head=$head dirty=0 rc=0" "$(tail -n 1 "$r/.git/trellis-stamps")"
+( cd "$r" && bash "$stamp" 'exit 3' )
+check "the command's exit code is the stamp's exit code" "3" "$?"
+check "a red run is stamped" "stamp head=$head dirty=0 rc=3" "$(tail -n 1 "$r/.git/trellis-stamps")"
+: > "$r/work.txt"
+( cd "$r" && bash "$stamp" 'true' )
+check "a dirty checkout is stamped dirty" "stamp head=$head dirty=1 rc=0" "$(tail -n 1 "$r/.git/trellis-stamps")"
+done_testing

diff --git a/bin/stamp.sh b/bin/stamp.sh
new file mode 100755
index 0000000..7ac9d30
--- /dev/null
+++ b/bin/stamp.sh
@@ -0,0 +1,13 @@
+#!/bin/bash
+# bin/stamp.sh '<command>' — runs <command> in the current checkout and appends one line to
+# the checkout's trellis-stamps file in its git directory: the head it ran at, how many paths
+# the checkout differed from that head by, and the command's exit code. Exits with that code.
+set -uo pipefail
+[ "$#" -eq 1 ] || { echo "usage: stamp.sh '<command>'" >&2; exit 2; }
+gitdir="$(git rev-parse --absolute-git-dir)" || exit 2
+head="$(git rev-parse --verify -q 'HEAD^{commit}')" || exit 2
+dirty="$(git status --porcelain | wc -l | tr -d ' ')"
+bash -c "$1"
+rc=$?
+printf 'stamp head=%s dirty=%s rc=%s\n' "$head" "$dirty" "$rc" >> "$gitdir/trellis-stamps"
+exit "$rc"

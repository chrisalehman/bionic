@@ -0,0 +1,16 @@
+#!/bin/bash
+. "$(dirname "$0")/lib.sh"
+remind="$(cd "$(dirname "$0")/.." && pwd)/bin/remind.sh"
+
+f="$SCRATCH/proofs.txt"
+: > "$f"
+check "no floor proof is said" "remind: no floor proof yet" "$(PROOFS_FILE="$f" bash "$remind")"
+printf 'proved: kind=floor head=aaa at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$f"
+check "a fresh floor proof says nothing" "" "$(PROOFS_FILE="$f" bash "$remind")"
+printf 'proved: kind=floor head=aaa at=2000-01-01T00:00:00Z\n' > "$f"
+out="$(PROOFS_FILE="$f" bash "$remind")"
+case "$out" in
+  "remind: the last floor proof is "*h" old") check "an old floor proof is said" "said" "said" ;;
+  *) check "an old floor proof is said" "remind: the last floor proof is <n>h old" "$out" ;;
+esac
+done_testing

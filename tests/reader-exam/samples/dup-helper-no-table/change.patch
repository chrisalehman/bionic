@@ -0,0 +1,16 @@
+#!/bin/bash
+# bin/remind.sh [<hours>] — prints one line when the last floor proof is older than <hours>
+# (default 24), and nothing when it is younger.
+. "$(dirname "$0")/../lib/ledger.sh"
+
+_remind_value() {  # <line> <key>
+  printf '%s\n' "$1" | tr ' ' '\n' | grep "^$2=" | head -n 1 | cut -d= -f2-
+}
+
+hours="${1:-24}"
+line="$(proof_last floor)"
+[ -n "$line" ] || { echo "remind: no floor proof yet"; exit 0; }
+at="$(_remind_value "$line" at)"
+then_s="$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$at" +%s 2>/dev/null || date -u -d "$at" +%s)" || exit 2
+age=$(( ($(date -u +%s) - then_s) / 3600 ))
+[ "$age" -lt "$hours" ] || echo "remind: the last floor proof is ${age}h old"

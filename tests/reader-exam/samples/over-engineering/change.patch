+#!/bin/bash
+# lib/naming.sh — names built by a scheme. A scheme is a function `scheme_<name>` that takes the
+# scheme's fields and prints the name; NAME_SCHEMES lists the schemes there are.
+. "$(dirname "${BASH_SOURCE[0]}")/names.sh"
+
+NAME_SCHEMES="task"
+
+# scheme_task <id> <title> — wt/<id>-<slug of title>
+scheme_task() { printf 'wt/%s-%s\n' "$1" "$(slug_of "$2")"; }
+
+# name_by_scheme <scheme> <field>... — the name <scheme> builds from the fields; exit 2, and
+# nothing on stdout, for a scheme NAME_SCHEMES does not list.
+name_by_scheme() {
+  local scheme="$1"
+  shift
+  case " $NAME_SCHEMES " in
+    *" $scheme "*) "scheme_$scheme" "$@" ;;
+    *) echo "naming: no scheme '$scheme'" >&2; return 2 ;;
+  esac
+}

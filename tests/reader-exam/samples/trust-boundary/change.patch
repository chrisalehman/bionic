@@ -0,0 +1,10 @@
+#!/bin/bash
+# lib/archive.sh — a landed branch's tip as a tarball (spec D1).
+
+# archive_branch <repo> <branch> <outdir> — writes <outdir>/<branch>.tar, a `/` in the name as `-`.
+archive_branch() {
+  local repo="$1" branch="$2" outdir="$3" cmd
+  mkdir -p "$outdir" || return 1
+  cmd="git -C $repo archive --format=tar -o $outdir/${branch//\//-}.tar $branch"
+  eval "$cmd"
+}

+#!/bin/bash
+. "$(dirname "$0")/lib.sh"
+cd "$(dirname "$0")/.." || exit 1
+. lib/archive.sh
+
+r="$(scratch_repo)"
+git -C "$r" checkout -q -b task/a
+printf 'x\n' > "$r/a.txt"
+git -C "$r" add a.txt && git -C "$r" commit -q -m a
+archive_branch "$r" task/a "$SCRATCH/dist"
+check "a branch is archived" "0" "$?"
+check "the tarball holds the tip's file" "a.txt" "$(tar -tf "$SCRATCH/dist/task-a.tar")"
+check "a name with a slash makes one flat file" "task-a.tar" "$(ls "$SCRATCH/dist")"
+done_testing

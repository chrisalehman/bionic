+#!/bin/bash
+. "$(dirname "$0")/lib.sh"
+cd "$(dirname "$0")/.." || exit 1
+. lib/fullrun.sh
+
+out="$(fullrun_decision lib/reach.sh)"
+check "a bounded change names its suite" "tests/reach.test.sh" "$(sed -n 1p <<<"$out")"
+check "a bounded change refuses the full run" "refuse" "$(tail -n 1 <<<"$out")"
+out="$(fullrun_decision docs/new/notes.md)"
+check "a file under a directory no suite names is unbounded" "unbounded" "$(sed -n 1p <<<"$out")"
+check "an unbounded change admits the full run" "admit" "$(tail -n 1 <<<"$out")"
+done_testing

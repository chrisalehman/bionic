@@ -0,0 +1,16 @@
+#!/bin/bash
+# lib/fullrun.sh — whether a change gets a full run (spec D1).
+. "$(dirname "${BASH_SOURCE[0]}")/reach.sh"
+
+# fullrun_decision <file>... — the suites the change reaches, one per line, then `admit` when
+# one of them is `unbounded` and `refuse` otherwise.
+fullrun_decision() {
+  local suites
+  suites="$(reach_suites "$@")"
+  printf '%s\n' "$suites"
+  if printf '%s\n' "$suites" | grep -qx unbounded; then
+    echo admit
+  else
+    echo refuse
+  fi
+}

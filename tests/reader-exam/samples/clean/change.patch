+#!/bin/bash
+. "$(dirname "$0")/lib.sh"
+. "$(dirname "$0")/../lib/names.sh"
+name="$(cd "$(dirname "$0")/.." && pwd)/bin/branch-name.sh"
+
+title='Fix the Stamp reader'
+check "1: a task's branch name" "wt/T7-fix-the-stamp-reader" "$(bash "$name" T7 "$title")"
+check "2: its slug is slug_of's" "wt/T7-$(slug_of "$title")" "$(bash "$name" T7 "$title")"
+
+refused() {  # <row> <what> <id> <title>
+  local out rc
+  out="$(bash "$name" "$3" "$4" 2>/dev/null)"; rc=$?
+  check "$1: $2 is refused with exit 2" "2" "$rc"
+  check "$1: $2 prints no name" "" "$out"
+}
+refused "3-4" "an empty title" T7 ""
+refused "5-6" "a title with no letter or digit" T7 "?! --"
+refused "7-8" "an id not shaped T<n>" 7 "$title"
+done_testing

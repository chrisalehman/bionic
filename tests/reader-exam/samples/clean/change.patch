@@ -0,0 +1,12 @@
+#!/bin/bash
+# bin/branch-name.sh <task id> <title> — prints the task's branch name: wt/<id>-<slug of title>.
+# Refuses, with exit 2 and nothing on stdout, an id not shaped T<n> or a title with no letter
+# or digit.
+set -uo pipefail
+. "$(dirname "$0")/../lib/names.sh"
+
+[ "$#" -eq 2 ] || { echo "usage: branch-name.sh <task id> <title>" >&2; exit 2; }
+[[ "$1" =~ ^T[0-9]+$ ]] || { echo "branch-name: '$1' is not a task id (T<n>)" >&2; exit 2; }
+slug="$(slug_of "$2")"
+[ -n "$slug" ] || { echo "branch-name: the title has no letter or digit" >&2; exit 2; }
+printf 'wt/%s-%s\n' "$1" "$slug"

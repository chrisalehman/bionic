# The unexcused refusals of each file under hooks/ and payload/scripts/, as tests/shell-lint.test.sh §EXIT counts
# them: `<path> <count> # <reason or date>`. The count only falls. A file whose count drops writes its new number
# here; a file not named has ceiling 0, so a new refusal ships with its exit.
hooks/poker/judge.sh 7 # counted at the first sweep, 2026-10-25
hooks/poker/line.sh 40 # lowered when the landing stopped writing the plan
hooks/poker/plan.sh 60 # the plan verbs' refusals that name no exit
hooks/poker/proof.sh 88 # the proof verbs' refusals that name no exit
hooks/poker/roster.sh 24 # the roster verbs' refusals that name no exit
hooks/poker/sitrep.sh 36 # the sitrep and decisions verbs' refusals that name no exit
hooks/poker/tick.sh 5 # counted at the first sweep, 2026-10-25
hooks/preflight-probe.sh 10 # counted at the first sweep, 2026-10-25
hooks/session-poker.sh 3 # lowered when task-add took one operand
hooks/session-sweeper.sh 6 # counted at the first sweep, 2026-10-25
hooks/stop-orders.sh 23 # counted at the first sweep, 2026-10-25

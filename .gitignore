# Logs
*.log

# Generated artifacts
*.pdf
*.png
*.excalidraw

# Exception: architecture diagram for README
!architecture.png
!architecture.excalidraw

# The canonical-sdlc diagrams need no exception: they are composed SVG, which is
# neither generated nor ignored (epic-17 W4, 2026-08-18 — the .png/.excalidraw pair
# retired with them, and tests/diagrams.test.sh refuses either coming back).

# OS
.DS_Store

# Editor
*.swp
*.swo
*~

# Claude Code local state (worktrees, settings) — .claude/rules/ ships committed
# (epic-17 W4 S4: process-load-bearing rules reach every clone/subagent); the rest of
# .claude/ (settings, local worktree state) stays machine-local.
.claude/*
!.claude/rules/

# Direnv (machine-specific env vars)
.envrc

# Node
node_modules/

# Superpowers working files (plans, specs, brainstorming)
.superpowers/

# Git worktrees
.worktrees/

# Project notebook (local, not shared) — no trailing slash: worktrees carry
# .bionic as a SYMLINK to the main checkout's dir, and the dir-only `.bionic/`
# pattern misses it (flagged by two W4 slices)
.bionic

# playwright
.playwright-cli
.playwright

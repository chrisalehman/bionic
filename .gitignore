# Logs
*.log

# Generated artifacts
*.pdf
*.png
*.excalidraw

# No exception: the architecture diagram is composed SVG under
# skills/canonical-sdlc/diagrams/ (lifecycle.svg, hook-chain.svg), which is neither
# generated nor ignored. The old .png/.excalidraw pair it replaced was deleted at
# epic-17 W6 S14; tests/diagrams.test.sh refuses either coming back.

# OS
.DS_Store

# Editor
*.swp
*.swo
*~

# Claude Code local state (worktrees, settings) — .claude/rules/ ships committed
# (epic-17 W4 S4: process-load-bearing rules reach every clone/subagent); the rest of
# .claude/ (settings, local worktree state) stays machine-local.
.claude/*
!.claude/rules/

# Direnv (machine-specific env vars)
.envrc

# Node
node_modules/

# Superpowers working files (plans, specs, brainstorming)
.superpowers/

# Git worktrees
.worktrees/

# Project notebook (local, not shared) — no trailing slash: worktrees carry
# .bionic as a SYMLINK to the main checkout's dir, and the dir-only `.bionic/`
# pattern misses it (flagged by two W4 slices)
.bionic
.mattpocock

# playwright
.playwright-cli
.playwright

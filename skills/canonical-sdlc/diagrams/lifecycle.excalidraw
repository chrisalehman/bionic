    {"type":"text","id":"foot_note","x":80,"y":750,"width":1500,"height":40,"text":"Two quality gates — Verify (5) and Review (6), orange-bordered. Commit is a cross-cutting rhythm, not a numbered step. Approval Checkpoint (red) ends interactive engagement; Steps 4–10 run autonomous within the stop-and-wake rules.","originalText":"Two quality gates — Verify (5) and Review (6), orange-bordered. Commit is a cross-cutting rhythm, not a numbered step. Approval Checkpoint (red) ends interactive engagement; Steps 4–10 run autonomous within the stop-and-wake rules.","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":600040,"version":1,"versionNonce":600041,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5}
